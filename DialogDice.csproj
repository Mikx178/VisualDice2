<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build with:  dotnet build -c Release -p:WrathPath="E:\Steam\steamapps\common\Pathfinder Second Adventure" -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>DialogDice</AssemblyName>
    <RootNamespace>DialogDice</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CS0168;CS0219;CS0649;CS0169;CS0414</NoWarn>
    <WrathPath Condition="'$(WrathPath)' == ''">E:\Steam\steamapps\common\Pathfinder Second Adventure</WrathPath>
    <ManagedDir>$(WrathPath)\Wrath_Data\Managed</ManagedDir>
    <UmmDir>$(ManagedDir)\UnityModManager</UmmDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(UmmDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityModManager">
      <HintPath>$(UmmDir)\UnityModManager.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Game UI sprites, embedded in the DLL (loaded by GameUI.cs) -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\*.png" LogicalName="DialogDice.Resources.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
